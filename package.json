{
  "name": "leadflow-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@leadflow/funnel",
    "dev:funnel": "npm run dev --workspace=@leadflow/funnel",
    "dev:admin": "npm run dev --workspace=@leadflow/admin",
    "build:funnel": "npm run build --workspace=@leadflow/funnel",
    "build:admin": "npm run build --workspace=@leadflow/admin",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "tsc": "npm run tsc --workspaces --if-present"
  }
}
