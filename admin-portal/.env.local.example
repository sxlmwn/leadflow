# ==============================================================================
# LeadFlow Admin Portal - Environment Variables Configuration
# Copy this file to .env.local: cp .env.local.example .env.local
# ==============================================================================

# Supabase project URL: Find this in your Supabase Dashboard under Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous API key for public client and auth requests: Find this in Supabase Dashboard under Project Settings > API > Project API Keys > "anon" / "public"
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase secret service role key (bypasses RLS for secure server admin tasks): Find this in Supabase Dashboard under Project Settings > API > Project API Keys > "service_role"
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# TrustedForm API key for TCPA certificate verification lookups: Find this in your ActiveProspect/TrustedForm account under Settings > API Keys
TRUSTEDFORM_API_KEY=placeholder_trustedform_api_key

# DNC Scrub API key for phone compliance verification lookups: Find this in your DNC scrubbing provider portal under API Settings
DNC_SCRUB_API_KEY=placeholder_dnc_api_key
